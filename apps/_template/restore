#!/usr/bin/env bash

set -euo pipefail

source "$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)/scripts/utils"

APP_NAME="$(basename "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)")"

# Keep the relative backup path and destination aligned with backup.
restore_directory "${1:-}" "$APP_NAME/app" "$HOME/.config/app"
