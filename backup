#!/usr/bin/env bash

set -e

# Source utility functions
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/scripts/utils"

BACKUP_DEST="$1"

if [ -z "$BACKUP_DEST" ]; then
    read -rp "Enter target backup directory path (e.g., /media/user/external_drive/migrux_backup): " BACKUP_DEST
fi

if [ -z "$BACKUP_DEST" ]; then
    log_error "No backup destination provided. Exiting."
    exit 1
fi

if [ -e "$BACKUP_DEST" ]; then
    if [ ! -d "$BACKUP_DEST" ]; then
        log_error "Backup destination exists but is not a directory: $BACKUP_DEST"
        exit 1
    fi

    if find "$BACKUP_DEST" -mindepth 1 -print -quit | grep -q .; then
        log_error "Backup destination must be empty: $BACKUP_DEST"
        exit 1
    fi
else
    mkdir -p "$BACKUP_DEST"
fi

log_info "Starting migration backup process to: $BACKUP_DEST"

APPS_DIR="$SCRIPT_DIR/apps"

if [ ! -d "$APPS_DIR" ] || [ -z "$(find "$APPS_DIR" -mindepth 1 -maxdepth 1 -type d ! -name '.*' ! -name '_*' -print -quit 2>/dev/null)" ]; then
    log_warn "No application directories found in $APPS_DIR."
    exit 0
fi

for app_path in "$APPS_DIR"/*; do
    if [ -d "$app_path" ]; then
        app_name=$(basename "$app_path")
        # Ignore hidden/template directories starting with _ or .
        if [[ "$app_name" =~ ^[_.] ]]; then
            continue
        fi
        run_app_script "$app_path" "backup" "$BACKUP_DEST"
    fi
done

log_success "Backup process finished successfully!"
